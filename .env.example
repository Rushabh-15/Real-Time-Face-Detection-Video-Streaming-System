# =============================================================================
# face-detect-stream — environment variables
# Copy to `.env` and fill in real values.  `.env` is gitignored.
# =============================================================================

# -------- App --------
APP_ENV=development                  # development | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# -------- HTTP server --------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -------- CORS --------
# Comma-separated origins. Never "*" — locked down per security rubric.
# Vite dev server runs on :5173.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------- Face detection (mediapipe) --------
DETECTION_MIN_CONFIDENCE=0.5         # 0.0–1.0

# -------- ROI persistence --------
# Persist 1-of-N frames to avoid 30 rows/sec at 30fps. Set to 1 to write every frame.
ROI_SAMPLE_EVERY_N_FRAMES=5

# -------- PostgreSQL --------
# These build the cluster (consumed by the postgres service in docker-compose).
POSTGRES_USER=face_app
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=face_detections
POSTGRES_HOST=postgres               # docker-compose service name
POSTGRES_PORT=5432

# This is what the app consumes (SQLAlchemy async + Alembic).
# Duplicates the above on purpose — compose needs the parts, the app needs the URL.
DATABASE_URL=postgresql+asyncpg://face_app:change_me_in_real_env@postgres:5432/face_detections
# Echo SQL to stdout (verbose). Off by default; flip on for migration debugging.
DB_ECHO=false

# -------- Rate limiting --------
# slowapi: per-IP cap on WebSocket connection attempts.
RATE_LIMIT_PER_MINUTE=30

# -------- Frontend (Vite) --------
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
VITE_BACKEND_WS_URL=ws://localhost:8000/api/v1/ws/face-stream
VITE_BACKEND_HTTP_URL=http://localhost:8000